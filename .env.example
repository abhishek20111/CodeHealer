# ══════════════════════════════════════════════════════════════════════════════
# OBS Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values below
#   3. Never commit .env to git (it's in .gitignore)
#
# GETTING YOUR CREDENTIALS:
#   - APP_ID: Your application's ID (ask your tech lead)
#   - Bearer Token: Get from service account (recommended for automation)
#   - Username/Password: Your log-service credentials (for manual testing)
#
# ══════════════════════════════════════════════════════════════════════════════

# ── GitHub Enterprise Token (Required for GitHub tools) ────────────────────
# Get token from: https://github.example.com/settings/tokens
# Permissions needed: repo (full control of private repositories)
GHE_TOKEN=ghp_your_github_enterprise_token_here
GHE_HOST=github.example.com

# ── GitHub.com Token (Optional - only if using public GitHub) ───────────────
# GITHUB_COM_TOKEN=ghp_your_github_com_token_here

# ── OBS Configuration (Required) ─────────────────────────────────────────────
# Your application's ID (e.g., 100000001)
OBS_APP_ID=100000001

# Environment: dev | qa | prod (determines proxy URL)
OBS_ENVIRONMENT=dev

# Authentication type: bearer_token | basic_auth | okta_token
OBS_AUTH_TYPE=bearer_token

# ── OBS Authentication (Choose ONE method) ───────────────────────────────────

# Method 1: Bearer Token (recommended for automation)
OBS_BEARER_TOKEN=your_service_account_token_here

# Method 2: Basic Auth (for manual testing)
# OBS_USERNAME=your_username
# OBS_PASSWORD=your_password

# ── OBS Proxy URLs (Auto-selected based on OBS_ENVIRONMENT) ──────────────────
# E1/dev:  https://obsproxy-dev.example.com
# E2/qa:   https://obsproxy-qa.example.com
# E3/prod: https://obsproxy.example.com
# 
# Override if needed:
# OBS_PROXY_URL=https://obsproxy-dev.example.com

# ── Corporate Proxy (optional) ───────────────────────────────────────────────────────
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# ── MySQL Database (Optional - for database tools) ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password

# ── Slack Configuration (Optional - for Slack integration) ──────────────────
# Get token from: https://api.slack.com/apps → Your App → OAuth & Permissions
# Required scopes: channels:read, channels:history, search:read, chat:write
# SLACK_TOKEN=xoxb-your-bot-token-here
# SLACK_WORKSPACE_URL=https://slack.com

# ── Ollama (For local embeddings) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Codex CLI Bridge (Optional, explicit read-only backend) ──────────────────
# Start ../copilot_proxy_simple/codex_bridge.js separately, then set:
# LLM_BACKEND=codex-bridge
# CODEX_BRIDGE_URL=http://127.0.0.1:3200/v1
# CODEX_BRIDGE_TOKEN=replace-with-a-long-random-local-token
# CODEX_BRIDGE_WORKDIR=/absolute/path/to/approved/workspace
# CODEX_BRIDGE_MODEL=approved-codex-model
# CODEX_BRIDGE_TIMEOUT_MS=300000
